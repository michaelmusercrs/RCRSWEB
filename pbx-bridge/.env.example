# RCR PBX Bridge — configuration. Copy to .env and fill in.
# Runs on "Boston" inside WSL. Reads localhost MySQL + local spool files,
# pushes OUT to the portal over HTTPS. Nothing here listens on a port.

# --- Portal (outbound only) ---
PORTAL_URL=https://rcrsal.com
# Shared secret; must equal CALLS_WEBHOOK_API_KEY set in the portal's Vercel env.
CALLS_WEBHOOK_API_KEY=

# --- CDR database (read-only user created by the Boston session) ---
CDR_DB_HOST=127.0.0.1
CDR_DB_PORT=3306
CDR_DB_USER=portal_bridge
# The read-only DB password (set on Boston when the portal_bridge user was created).
CDR_DB_PASSWORD=
CDR_DB_NAME=asteriskcdrdb

# --- Timing ---
POLL_INTERVAL_SECONDS=30
# Wait this long after a call's last CDR leg before treating it as settled and
# emitting (so all legs of one call are aggregated together).
SETTLE_SECONDS=60

# --- Topology (defaults match the dialplan as of 2026-07-31; override if it changes) ---
PBX_DID=2565154245
ANSWERING_SERVICE=2566848240
# Extensions that can answer, comma-separated.
EXTENSIONS=101,102,103,104,105,106,107,108

# --- Recordings (Blob upload via portal token). Leave disabled for first runs. ---
RECORDINGS_ENABLED=false
RECORDING_DIR=/var/spool/asterisk/monitor
# ffmpeg transcode target: opus keeps voice tiny (~24kbps). Set to "off" to upload WAV as-is.
RECORDING_TRANSCODE=opus
FFMPEG_BIN=ffmpeg

# --- Voicemail watcher. Leave disabled for first runs. ---
VOICEMAIL_ENABLED=false
VOICEMAIL_DIR=/var/spool/asterisk/voicemail/default

# --- State (watermark + dead-letter live here; must be writable + persistent) ---
STATE_DIR=./state
