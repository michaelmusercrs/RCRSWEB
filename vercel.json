{
  "framework": "nextjs",
  "buildCommand": "rm -rf .next node_modules/.cache && npm run build",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/check-lead-timers",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/auto-reassign",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/publish-blog",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/meeting-reset",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/backup-sheets",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-inventory-tab",
      "schedule": "*/10 * * * *"
    }
  ],
  "_disabledCrons": {
    "_note": "Entries below are intentionally NOT in the live `crons` array. Move them up once the owner provisions the required env vars. Vercel ignores any top-level key starting with an underscore.",
    "review-request-queue": {
      "path": "/api/cron/review-request-queue",
      "schedule": "0 19 * * *",
      "_status": "disabled",
      "_enableWhen": "ENABLE_REVIEW_REQUESTS=true and NEXT_PUBLIC_GOOGLE_REVIEW_URL are set in Vercel env",
      "_addedBy": "sweep/review-automation"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/command-center/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rcrsal.com"
        }
      ],
      "destination": "/portal"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.rcrsal.com"
        }
      ],
      "destination": "/portal"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rivercityroofingsolutions.com"
        }
      ],
      "destination": "https://www.rivercityroofingsolutions.com/:path*",
      "permanent": true
    }
  ]
}
