{
  "framework": "nextjs",
  "buildCommand": "rm -rf .next node_modules/.cache && npm run build",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/check-lead-timers",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/auto-reassign",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/publish-blog",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/meeting-reset",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/backup-sheets",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-inventory-tab",
      "schedule": "*/10 * * * *"
    }
  ],
  "_disabledCrons": [
    {
      "_note": "DRAFT — pre-generates Monday meeting prep so it's ready when owner wakes Monday. Move into `crons` to enable. Schedule = 6pm Sunday Central (DST) / midnight UTC Monday.",
      "path": "/api/cron/monday-prep-pregen",
      "schedule": "0 0 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/command-center/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rcrsal.com"
        }
      ],
      "destination": "/portal"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.rcrsal.com"
        }
      ],
      "destination": "/portal"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rivercityroofingsolutions.com"
        }
      ],
      "destination": "https://www.rivercityroofingsolutions.com/:path*",
      "permanent": true
    }
  ]
}
