{
  "framework": "nextjs",
  "buildCommand": "rm -rf .next node_modules/.cache && npm run build",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/check-lead-timers",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/auto-reassign",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/publish-blog",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/meeting-reset",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/backup-sheets",
      "schedule": "40 */6 * * *"
    },
    {
      "path": "/api/cron/sync-inventory-tab",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/chrisview-precompute",
      "schedule": "30 */3 * * *"
    },
    {
      "path": "/api/cron/weekly-response-time-report",
      "schedule": "35 12 * * 1"
    },
    {
      "path": "/api/cron/refresh-weather-forecast",
      "schedule": "5 */3 * * *"
    },
    {
      "path": "/api/cron/auto-finalize-tickets",
      "schedule": "17 13 * * *"
    },
    {
      "path": "/api/cron/stalled-tickets-digest",
      "schedule": "12 12 * * *"
    },
    {
      "path": "/api/cron/forwarder-heartbeat",
      "schedule": "25 17,22 * * 1-6"
    },
    {
      "path": "/api/cron/low-stock-alert",
      "schedule": "20 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/command-center/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rcrsal.com"
        }
      ],
      "destination": "/portal"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.rcrsal.com"
        }
      ],
      "destination": "/portal"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rivercityroofingsolutions.com"
        }
      ],
      "destination": "https://www.rivercityroofingsolutions.com/:path*",
      "permanent": false
    }
  ]
}
