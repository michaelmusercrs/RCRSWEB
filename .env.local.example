# River City Roofing Solutions - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# SECURITY - AUTHENTICATION (Server-side only)
# ============================================

# JWT Secret for token signing (REQUIRED for production)
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-change-in-production

# Alternative name for JWT secret
AUTH_SECRET=your-secure-auth-secret-change-in-production

# Admin password (server-side only - NOT exposed to browser)
# This replaces the old NEXT_PUBLIC_ADMIN_PASSWORD
ADMIN_PASSWORD=your-secure-admin-password

# ============================================
# FORM SUBMISSION - GOOGLE APPS SCRIPT
# ============================================

# Your Google Apps Script web app endpoint URL
# Format: https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Get this after deploying your Google Apps Script (see docs/setup/FORM_SETUP_GUIDE.md)
NEXT_PUBLIC_GOOGLE_SCRIPT_ENDPOINT=

# ============================================
# SITE CONFIGURATION (Optional)
# ============================================

# Your site URL (used for canonical URLs and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# MARKETING & TRACKING
# ============================================

# Google Analytics 4 Measurement ID
# Get this from: Google Analytics > Admin > Data Streams > Web
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Facebook/Meta Pixel ID
# Get this from: Facebook Events Manager > Data Sources > Pixel
# Format: 15-16 digit number
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Ads Account ID (for remarketing)
# Get this from: Google Ads > Tools & Settings > Account Information
# Format: AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads Conversion Labels (optional, for specific conversion tracking)
# These are created in Google Ads > Tools & Settings > Conversions
# Format: conversion_label from your conversion action
NEXT_PUBLIC_GADS_FORM_CONVERSION=
NEXT_PUBLIC_GADS_PHONE_CONVERSION=
NEXT_PUBLIC_GADS_QUOTE_CONVERSION=

# ============================================
# IMAGE UPLOAD (Optional)
# ============================================

# Maximum image upload size in MB (default: 10)
# MAX_IMAGE_SIZE_MB=10

# ============================================
# SYSTEM CONFIGURATION
# ============================================

# Maintenance mode (true/false)
MAINTENANCE_MODE=false

# Maintenance bypass token for admin access during maintenance
MAINTENANCE_BYPASS_TOKEN=your-secure-bypass-token

# Feature flags (JSON string of enabled/disabled features)
# Example: {"voice-notifications":true,"ai-chat-support":false}
FEATURE_FLAGS={}

# Application version
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# EXTERNAL SERVICES
# ============================================

# JobNimbus API (for customer portal)
JOBNIMBUS_API_KEY=
JOBNIMBUS_API_URL=https://app.jobnimbus.com/api1

# Google Sheets (for portal data)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# ============================================
# WEATHER SERVICE (Optional)
# ============================================

# OpenWeatherMap API Key (Optional - weather service uses Open-Meteo by default which is free)
# Get this from: https://openweathermap.org/api
# The default Open-Meteo API does not require an API key
OPENWEATHERMAP_API_KEY=

# Default location for weather (zip code)
NEXT_PUBLIC_DEFAULT_WEATHER_ZIP=35640

# ============================================
# NOTES
# ============================================

# IMPORTANT SECURITY NOTE:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - NEVER put secrets in NEXT_PUBLIC_ variables
# - Use server-side only variables for passwords, API keys, and tokens

# After changing this file:
# 1. Restart your development server: npm run dev
# 2. For Vercel: Add variables in dashboard > Settings > Environment Variables
# 3. Redeploy to apply changes

# DO NOT commit .env.local to Git - it's in .gitignore
