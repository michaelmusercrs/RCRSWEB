# ============================================================
# River City Roofing Solutions - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to Git - it's in .gitignore
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# All other variables are server-side only (secure)
# ============================================================

# ============================================================
# REQUIRED - Core Integrations
# ============================================================

# ----- JobNimbus CRM API -----
# Get from: JobNimbus > Settings > API > Generate API Key
JOBNIMBUS_API_KEY=your_jobnimbus_api_key_here
JOBNIMBUS_API_URL=https://app.jobnimbus.com/api1

# ----- Google Sheets (Data Storage & Sync) -----
# FULL SETUP GUIDE: docs/GOOGLE_SHEETS_SETUP.md
# SHEET STRUCTURE: docs/GOOGLE_SHEETS_STRUCTURE.md
#
# Get from: Google Cloud Console > Service Account > Create Key (JSON)
# Steps:
#   1. Create Google Cloud project
#   2. Enable Google Sheets API
#   3. Create service account
#   4. Download JSON key
#   5. Share spreadsheet with service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your_main_google_sheet_id

# Optional: Separate sheets for different data
# INVENTORY_SHEETS_ID=your_inventory_sheet_id
# DELIVERY_SHEETS_ID=your_delivery_portal_sheet_id

# ----- Google Apps Script (Form Handling) -----
# Get from: Google Apps Script > Deploy > Web app > URL
NEXT_PUBLIC_GOOGLE_SCRIPT_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================

# Admin Panel Password (SERVER-SIDE ONLY - NOT NEXT_PUBLIC!)
# Change this in production!
ADMIN_PASSWORD=your_secure_admin_password_here

# JWT Secret for session tokens (generate a random 64+ char string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_at_least_64_characters_long
# AUTH_SECRET=alternative_auth_secret_if_needed

# ============================================================
# VERCEL DEPLOYMENT
# ============================================================

# Vercel Blob Storage (for file uploads)
# Auto-configured when linked to Vercel project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# ============================================================
# ANALYTICS & TRACKING
# ============================================================

# Google Analytics 4 Measurement ID
# Get from: Google Analytics > Admin > Property > Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Facebook Pixel ID (optional)
# Get from: Facebook Events Manager > Data Sources > Pixels
# NEXT_PUBLIC_FB_PIXEL_ID=your_fb_pixel_id

# ============================================================
# TEAM COMMUNICATION - GroupMe
# ============================================================

# GroupMe Bot for team notifications
# Get from: https://dev.groupme.com/bots
GROUPME_BOT_ID=your_groupme_bot_id
GROUPME_ACCESS_TOKEN=your_groupme_access_token
GROUPME_ENABLED=true

# Notification toggles (all default to true)
# GROUPME_NOTIFY_NEW_LEAD=true
# GROUPME_NOTIFY_PROFILE_EDIT=true
# GROUPME_NOTIFY_LOW_INVENTORY=true
# GROUPME_NOTIFY_JOB_STATUS=true
# GROUPME_NOTIFY_PORTAL_ACTIVITY=true
# GROUPME_NOTIFY_DELIVERY=true
# GROUPME_NOTIFY_SLA=true

# ============================================================
# CALENDAR - TeamUp
# ============================================================

# TeamUp Calendar Integration
# Get from: https://teamup.com > Settings > Apps & Integrations
TEAMUP_API_KEY=your_teamup_api_key
TEAMUP_CALENDAR_KEY=your_teamup_calendar_key

# Sub-calendar IDs (optional - for event categorization)
# TEAMUP_SUBCAL_INSPECTIONS=subcal_id_1
# TEAMUP_SUBCAL_INSTALLATIONS=subcal_id_2
# TEAMUP_SUBCAL_DELIVERIES=subcal_id_3
# TEAMUP_SUBCAL_MEETINGS=subcal_id_4
# TEAMUP_SUBCAL_GENERAL=subcal_id_5

# ============================================================
# MESSAGING - Twilio (SMS) & SendGrid (Email)
# ============================================================

# Twilio SMS Integration (optional)
# Get from: https://console.twilio.com
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email Integration (optional)
# Get from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=your_sendgrid_api_key
# FROM_EMAIL=noreply@rivercityroofingsolutions.com

# ============================================================
# WEBHOOKS & EXTERNAL INTEGRATIONS
# ============================================================

# JobNimbus Webhook Secret (for incoming webhooks)
# Set when configuring webhooks in JobNimbus
# JOBNIMBUS_WEBHOOK_SECRET=your_webhook_secret

# Call Recording Webhook API Key
# Generate a secure random key for PBX integration
# CALLS_WEBHOOK_API_KEY=your_calls_webhook_api_key

# GitHub Token (for admin dashboard features)
# Get from: GitHub > Settings > Developer Settings > Personal Access Tokens
# GITHUB_TOKEN=ghp_xxxx

# ============================================================
# SITE CONFIGURATION
# ============================================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://www.rivercityroofingsolutions.com

# Company Info (public)
NEXT_PUBLIC_COMPANY_NAME=River City Roofing Solutions
NEXT_PUBLIC_COMPANY_PHONE=256-274-8530
NEXT_PUBLIC_COMPANY_LOCATION=Hartselle, AL

# App Version (for debugging)
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================
# FEATURE FLAGS & MAINTENANCE
# ============================================================

# Maintenance Mode (set to 'true' to enable)
# MAINTENANCE_MODE=false

# Feature Flags (JSON format)
# FEATURE_FLAGS={"newDashboard":true,"betaFeatures":false}

# ============================================================
# DEVELOPMENT ONLY
# ============================================================

# These are typically auto-set by Vercel in production
# NODE_ENV=development
# VERCEL_ENV=development

# ----- AI Roof Measurement -----
# Google Solar API (uses same Google Maps key, just enable Solar API in Cloud Console)
# Gemini AI (for roof analysis - get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# Anthropic Claude (for roof analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Ollama runs locally on port 11434 (install from https://ollama.ai, then: ollama pull llava:7b)
